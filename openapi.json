    "/auth/signup": {
      "post": {
        "tags": [
          "Auth"
        ],
        "description": "Customer or user registration",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "name": {
                    "minLength": 2,
                    "maxLength": 255,
                    "type": "string"
                  },
                  "email": {
                    "format": "email",
                    "type": "string"
                  },
                  "password": {
                    "minLength": 8,
                    "maxLength": 100,
                    "type": "string"
                  },
                  "date_of_birth": {
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
                    "type": "string"
                  }
                },
                "required": [
                  "name",
                  "email",
                  "password"
                ]
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "user": {
                          "type": "object",
                          "properties": {
                            "id": {
                              "type": "number"
                            },
                            "name": {
                              "type": "string"
                            },
                            "email": {
                              "type": "string"
                            },
                            "roleId": {
                              "type": "number"
                            },
                            "roleName": {
                              "type": "string"
                            },
                            "isActive": {
                              "type": "boolean"
                            },
                            "emailVerifiedAt": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            },
                            "twoFactorEnabled": {
                              "type": "boolean"
                            },
                            "dateOfBirth": {
                              "anyOf": [
                                {
                                  "type": "string"
                                },
                                {
                                  "type": "null"
                                }
                              ]
                            }
                          },
                          "required": [
                            "id",
                            "name",
                            "email",
                            "roleId",
                            "isActive",
                            "emailVerifiedAt",
                            "twoFactorEnabled"
                          ]
                        },
                        "verification_required": {
                          "type": "boolean"
                        },
                        "verification_token": {
                          "type": "string"
                        },
                        "verification_code": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "user",
                        "verification_required"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "409": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "422": {
            "description": "Default Response",
