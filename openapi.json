{
  "openapi": "3.0.3",
  "info": {
    "title": "Universal CMS Core API",
    "description": "Reusable headless CMS REST API specification",
    "version": "0.1.0"
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {}
  },
  "paths": {
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "description": "System health check and database connectivity status",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "ok"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "degraded"
                              ]
                            }
                          ]
                        },
                        "version": {
                          "type": "string"
                        },
                        "uptimeSeconds": {
                          "type": "number"
                        },
                        "timestamp": {
                          "type": "string"
                        },
                        "environment": {
                          "type": "string"
                        },
                        "database": {
                          "type": "object",
                          "properties": {
                            "connected": {
                              "type": "boolean"
                            },
                            "poolLimit": {
                              "type": "number"
                            },
                            "error": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "connected",
                            "poolLimit"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "version",
                        "uptimeSeconds",
                        "timestamp",
                        "environment",
                        "database"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "503": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "status": {
                          "anyOf": [
                            {
                              "type": "string",
                              "enum": [
                                "ok"
                              ]
                            },
                            {
                              "type": "string",
                              "enum": [
                                "degraded"
                              ]
                            }
                          ]
                        },
                        "version": {
                          "type": "string"
                        },
                        "uptimeSeconds": {
                          "type": "number"
                        },
                        "timestamp": {
                          "type": "string"
                        },
                        "environment": {
                          "type": "string"
                        },
                        "database": {
                          "type": "object",
                          "properties": {
                            "connected": {
                              "type": "boolean"
                            },
                            "poolLimit": {
                              "type": "number"
                            },
                            "error": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "connected",
                            "poolLimit"
                          ]
                        }
                      },
                      "required": [
                        "status",
                        "version",
                        "uptimeSeconds",
                        "timestamp",
                        "environment",
                        "database"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/admin/modules": {
      "get": {
        "tags": [
          "Admin Modules"
        ],
        "description": "Get all core and optional modules with enabled status",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "name": {
                            "type": "string"
                          },
                          "version": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "isCore": {
                            "type": "boolean"
                          },
                          "isEnabled": {
                            "type": "boolean"
                          },
                          "dependsOn": {
                            "type": "array",
                            "items": {
                              "type": "string"
                            }
                          }
                        },
                        "required": [
                          "name",
                          "version",
                          "description",
                          "isCore",
                          "isEnabled",
                          "dependsOn"
                        ]
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/admin/modules/{name}": {
      "patch": {
        "tags": [
          "Admin Modules"
        ],
        "description": "Toggle module enabled state",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "is_enabled": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "is_enabled"
                ]
              }
            }
          },
          "required": true
        },
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "in": "path",
            "name": "name",
            "required": true
          }
        ],
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "object",
                      "properties": {
                        "name": {
                          "type": "string"
                        },
                        "version": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "isCore": {
                          "type": "boolean"
                        },
                        "isEnabled": {
                          "type": "boolean"
                        },
                        "dependsOn": {
                          "type": "array",
                          "items": {
                            "type": "string"
                          }
                        }
                      },
                      "required": [
                        "name",
                        "version",
                        "description",
                        "isCore",
                        "isEnabled",
                        "dependsOn"
                      ]
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          },
          "404": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "error": {
                      "type": "object",
                      "properties": {
                        "code": {
                          "type": "string"
                        },
                        "message": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "code",
                        "message"
                      ]
                    }
                  },
                  "required": [
                    "error"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/admin/navigation": {
      "get": {
        "tags": [
          "Admin Navigation"
        ],
        "description": "Get admin navigation menu items for currently enabled modules",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "label": {
                            "type": "string"
                          },
                          "route": {
                            "type": "string"
                          },
                          "permission": {
                            "type": "string"
                          },
                          "order": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "id",
                          "label",
                          "route",
                          "permission"
                        ]
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/blog/posts": {
      "get": {
        "tags": [
          "Blog"
        ],
        "description": "List blog posts",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "number"
                          },
                          "title": {
                            "type": "string"
                          },
                          "slug": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "title",
                          "slug"
                        ]
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    },
    "/store/products": {
      "get": {
        "tags": [
          "Store"
        ],
        "description": "List store products",
        "responses": {
          "200": {
            "description": "Default Response",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "data": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "number"
                          },
                          "name": {
                            "type": "string"
                          },
                          "price": {
                            "type": "number"
                          }
                        },
                        "required": [
                          "id",
                          "name",
                          "price"
                        ]
                      }
                    }
                  },
                  "required": [
                    "data"
                  ]
                }
              }
            }
          }
        }
      }
    }
  },
  "servers": [
    {
      "url": "/api/v1",
      "description": "Current environment API v1 base"
    }
  ]
}