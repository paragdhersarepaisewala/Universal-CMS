# Server Environment Configuration
NODE_ENV=development
PORT=3000
HOST=0.0.0.0

# Database Configuration (MySQL)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=cms_user
DB_PASSWORD=cms_secret_password
DB_NAME=cms_core

# Database Connection Pool
# NOTE: Check your Hostinger plan's maximum MySQL connections limit in hPanel.
# Shared hosting typically allows limited concurrent connections (e.g., 20-50).
# Keep DB_POOL_SIZE small (default is 5).
DB_POOL_SIZE=5

# Application Secrets
# Generate a strong 64-character random string for production
APP_SECRET=replace_with_a_secure_random_string_at_least_32_chars_long

# Cache Driver: memory | file
CACHE_DRIVER=memory
CACHE_FILE_DIR=./.cache

# Job Runner Authentication Token
# Used by Hostinger cron jobs to trigger the background jobs processing endpoint
JOB_RUNNER_SECRET=replace_with_secure_job_runner_secret

# Initial Seed Admin Account (used only on first seed run)
SEED_OWNER_EMAIL=owner@example.com
SEED_OWNER_PASSWORD=ChangeMe123!
SEED_OWNER_NAME=System Owner
